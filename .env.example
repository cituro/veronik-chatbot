# Copiaza acest fisier in ".env" si completeaza valorile

# Cheia ta API de la Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modelul folosit pentru conversatie
ANTHROPIC_MODEL=claude-sonnet-4-5

# Portul pe care ruleaza serverul
PORT=3001

# Parola pentru panoul de administrare (upload documente / scanare site)
ADMIN_PASSWORD=schimba-parola-asta

# Domenii de pe care este permis widget-ul (separate prin virgula). Foloseste "*" pentru toate.
ALLOWED_ORIGINS=*
